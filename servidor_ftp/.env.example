# Servidor de archivos (Laptop 5). Copiar a .env y completar.

# Interfaz donde escucha: 0.0.0.0 = todas (LAN y Tailscale).
FTP_HOST=0.0.0.0
FTP_PORT=2121

# Credenciales que usa el backend (FTP_USERNAME / FTP_PASSWORD en backend-api/.env).
FTP_USER=clinica
FTP_PASSWORD=

# IPs o redes autorizadas, separadas por coma: solo la Laptop 3 (backend).
# Ejemplo LAN + Tailscale: 192.168.1.30,100.64.0.0/10
FTP_ALLOWED_IPS=192.168.1.30

# Rango de puertos pasivos (debe estar abierto en el firewall).
FTP_PASSIVE_PORTS=60000-60100
# IP que se anuncia en modo pasivo. Vacío = la IP por la que llegó el cliente.
FTP_MASQUERADE_ADDRESS=

# Opcionales
# FTP_DIR=/srv/clinica/archivos
# FTP_LOG=/var/log/clinica/ftp.log
FTP_IDLE_TIMEOUT=300
FTP_MAX_CONS=100
FTP_MAX_CONS_PER_IP=20
