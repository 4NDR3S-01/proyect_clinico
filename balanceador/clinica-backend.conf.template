# Paso de una petición a las instancias del backend (Laptop 3, HTTP).
proxy_pass http://clinica_backend;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
# El backend confía en estas cabeceras solo si vienen del balanceador (TRUSTED_PROXIES).
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Request-ID $request_id;

# Tiempos máximos: conectar rápido para pasar a la otra instancia si una cayó.
proxy_connect_timeout 2s;
proxy_send_timeout 30s;
proxy_read_timeout 30s;

# Reintenta en la otra instancia solo si no se pudo conectar o no respondió.
# NGINX no reintenta POST/PUT/DELETE, así no se duplican citas ni pagos.
proxy_next_upstream error timeout;
proxy_next_upstream_tries 2;
proxy_next_upstream_timeout 10s;

# Se devuelven las respuestas del backend; NGINX solo responde por su cuenta
# cuando ninguna instancia está disponible (502/504).
proxy_intercept_errors off;
error_page 502 504 = @backend_no_disponible;

# add_header en una location anula los del server, por eso se repiten aquí.
add_header X-Upstream $upstream_addr always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
