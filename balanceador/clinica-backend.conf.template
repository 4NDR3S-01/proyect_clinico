# Paso de una petición a las instancias PHP-FPM del backend (Laptop 3).
# FastCGI envía REMOTE_ADDR con la IP real del cliente.
fastcgi_pass clinica_backend;
fastcgi_keep_conn on;

include fastcgi_params;
fastcgi_param SCRIPT_FILENAME ${BACKEND_DIR}/public/index.php;
fastcgi_param SCRIPT_NAME /index.php;
fastcgi_param DOCUMENT_ROOT ${BACKEND_DIR}/public;
fastcgi_param HTTP_X_REQUEST_ID $request_id;
fastcgi_param HTTP_PROXY "";

# Tiempos máximos: conectar rápido para pasar a la otra instancia si una cayó.
fastcgi_connect_timeout 2s;
fastcgi_send_timeout 30s;
fastcgi_read_timeout 30s;

# Reintenta en la otra instancia solo si no se pudo conectar o no respondió.
# NGINX no reintenta POST/PUT/DELETE, así no se duplican citas ni pagos.
fastcgi_next_upstream error timeout invalid_header;
fastcgi_next_upstream_tries 2;
fastcgi_next_upstream_timeout 10s;

# Se devuelven las respuestas del backend; NGINX solo responde por su cuenta
# cuando ninguna instancia está disponible (502/504).
fastcgi_intercept_errors off;
error_page 502 504 = @backend_no_disponible;

# Muestra al cliente qué instancia respondió (Laravel añade X-Backend-Instance).
# add_header en una location anula los del server, por eso se repiten aquí.
add_header X-Upstream $upstream_addr always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
