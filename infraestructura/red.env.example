# ==============================================================================
# Red del proyecto en el switch del aula (presentación final).
# Copiar a red.env en cada laptop: debe ser IDÉNTICO en las cinco.
# Para trabajar desde casa usar red.tailscale.env.example.
# ==============================================================================

# Laptop 1 - Balanceador NGINX. Entrada de web y móvil.
BALANCEADOR_IP=192.168.1.10
# Laptop 2 - Frontend web
WEB_IP=192.168.1.20
WEB_PORT=8080
# Laptop 3 - Backend, 2 instancias PHP
BACKEND_IP=192.168.1.30
BACKEND1_PORT=8001
BACKEND2_PORT=8002
# Laptop 4 - PostgreSQL
BD_IP=192.168.1.40
BD_PORT=5432
BD_NOMBRE=proyect_clinico
# Laptop 5 - Servidor de archivos FTP
ARCHIVOS_IP=192.168.1.50
FTP_PORT=2121
FTP_PASSIVE_PORTS=60000-60100

# Dirección con la que los clientes abren el sistema.
SERVER_NAME=192.168.1.10
