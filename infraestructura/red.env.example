# ==============================================================================
# Red del proyecto: IPs y puertos de los cinco nodos.
# Copiar a red.env en cada laptop y usar la MISMA versión en todas.
#
# Modo LAN (switch): IPs 192.168.1.x como abajo.
# Modo Tailscale:    usar red.tailscale.env.example (IPs 100.x de cada laptop).
# ==============================================================================

# Laptop 1 - NGINX (reverse proxy / balanceador). Punto de entrada de los clientes.
BALANCEADOR_IP=192.168.1.10
# Laptop 2 - Servidor del frontend web
WEB_IP=192.168.1.20
WEB_PORT=8080
# Laptop 3 - Backend (2 instancias PHP-FPM)
BACKEND_IP=192.168.1.30
BACKEND1_PORT=9001
BACKEND2_PORT=9002
# Laptop 4 - PostgreSQL
BD_IP=192.168.1.40
BD_PORT=5432
# Laptop 5 - Servidor de archivos FTP
ARCHIVOS_IP=192.168.1.50
FTP_PORT=2121
FTP_PASSIVE_PORTS=60000:60100

# Nombre con el que se accede al sistema (IP del balanceador o un dominio local).
SERVER_NAME=192.168.1.10

# Ruta del backend en la Laptop 3 (debe ser la misma que usa NGINX en la Laptop 1).
BACKEND_DIR=/opt/clinica/backend-api
