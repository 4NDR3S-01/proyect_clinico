# Instancias del backend: clinica-backend@1 y clinica-backend@2.
#   sudo systemctl stop clinica-backend@2    -> simula la caída de una instancia
#   sudo systemctl start clinica-backend@2   -> la recupera
[Unit]
Description=Backend Proyecto Clinico - instancia %i (PHP-FPM)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
RuntimeDirectory=clinica
RuntimeDirectoryPreserve=yes
ExecStart=${PHP_FPM_BIN} --nodaemonize --fpm-config /etc/clinica/backend%i.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
