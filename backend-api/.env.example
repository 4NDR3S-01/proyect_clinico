APP_NAME="Clinica Odontologica"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Las horas de las citas se guardan en hora local del consultorio.
APP_TIMEZONE=America/Guayaquil

# Nombre de esta instancia: backend1 o backend2 (lo define cada servicio en la Laptop 3).
BACKEND_INSTANCE=backend1
# IP del balanceador NGINX (Laptop 1). Separar varias con coma (LAN y Tailscale).
TRUSTED_PROXIES=100.102.99.114

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL en la Laptop 4. Para desarrollo local se puede usar DB_CONNECTION=sqlite.
DB_CONNECTION=pgsql
DB_HOST=100.104.9.95
DB_PORT=5432
DB_DATABASE=proyect_clinico
DB_USERNAME=clinica_app
DB_PASSWORD=
# Esquemas por área (ver la migración organizar_esquemas).
DB_SEARCH_PATH=public,seguridad,clinica,citas,finanzas,catalogo,auditoria
# Segundos máximos para conectar y para cada consulta.
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT=15

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Servidor de archivos FTP (Laptop 5).
FTP_HOST=100.127.65.82
FTP_PORT=2121
FTP_USERNAME=clinica
FTP_PASSWORD=
FTP_ROOT=/
FTP_TIMEOUT=5
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#MAIL_MAILER=log
# Recuperación mediante API HTTPS de Brevo: ver docs/password-recovery.md.
BREVO_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
#MAIL_TIMEOUT=15
#MAIL_SCHEME=null
#MAIL_HOST=127.0.0.1
#MAIL_PORT=2525
#MAIL_USERNAME=null
#MAIL_PASSWORD=null
#MAIL_FROM_ADDRESS="hello@example.com"
#MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Web publicada en Vercel (ver frontend-web/VERCEL.md). Vacío = cualquier origen.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=

# Cuenta inicial de la doctora (php artisan db:seed --force).
DOCTORA_USERNAME=doctora
DOCTORA_EMAIL=doctora@clinica.com
DOCTORA_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
