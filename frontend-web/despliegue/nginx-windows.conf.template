# ==============================================================================
# Laptop 2 (Windows) - NGINX que publica el frontend web compilado.
# Generado por instalar.ps1 a partir de red.env. Solo acepta al balanceador.
# ==============================================================================
worker_processes 1;
pid logs/nginx.pid;
error_log logs/clinica_web_error.log warn;

events { worker_connections 256; }

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;
    access_log logs/clinica_web_access.log;

    # Carpetas temporales relativas a NGINX (los mismos valores que trae NGINX para Windows).
    client_body_temp_path temp/client_body_temp;
    proxy_temp_path temp/proxy_temp;
    fastcgi_temp_path temp/fastcgi_temp;
    uwsgi_temp_path temp/uwsgi_temp;
    scgi_temp_path temp/scgi_temp;

    server {
        listen ${WEB_PORT};
        server_name _;

        root ${WEB_ROOT};
        index index.html;

        allow 127.0.0.1;
        allow ${BALANCEADOR_IP};
        deny all;

        # Archivos con hash en el nombre: se pueden guardar en caché mucho tiempo.
        location /assets/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Rutas de React Router: cualquier ruta desconocida carga index.html.
        location / {
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /index.html;
        }
    }
}
